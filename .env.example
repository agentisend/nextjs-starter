# A key with sending_access, from https://console.agentisend.com/api-keys
AGENTISEND_API_KEY=as_...
# The From address. It must be on a domain you have verified in AgentiSend.
MAIL_FROM="Contact form <contact@yourdomain.com>"
# Where messages from the form go. The form never sends anywhere else.
CONTACT_TO=you@yourdomain.com
